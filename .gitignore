# --- Кэш и скомпилированные файлы Python ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Папки виртуальных окружений ---
.conda/
venv/
env/
.venv-tf/

# --- Файлы IDE и редакторов кода ---
.vscode/
.idea/

# --- Критически важные секретные данные ---
# Никогда не добавляйте ваш API-токен в Git!
.env

# --- Сгенерированные файлы проекта ---
# 1. Игнорируем всё СОДЕРЖИМОЕ папки data, но разрешаем Git зайти внутрь
data/*

# 2. Разрешаем Git спускаться по дереву папок до нужного уровня
!data/processed/
data/processed/*

!data/processed/2000_2026_1d/
data/processed/2000_2026_1d/*

!data/processed/2000_2026_1d/fold_*/
data/processed/2000_2026_1d/fold_*/*

# 3. Наконец-то разрешаем саму папку models и её содержимое!
!data/processed/2000_2026_1d/fold_*/models/

# (Опционально) Разрешаем папку чемпионов и метаданные окружения
!data/processed/2000_2026_1d/rl_env/
data/processed/2000_2026_1d/rl_env/*
!data/processed/2000_2026_1d/rl_env/champions/
!data/processed/2000_2026_1d/rl_env/env_metadata.json

# Все результаты, логи, графики и модели
*.log
*.png
*.pkl
*.json

# --- Временные и служебные файлы ---
# Файлы, которые могут случайно появиться в корневой папке
features*.csv
optimization*.csv
grid_search*.csv
hypercube*.csv
multistart*.csv
stratified*.csv
filelist.txt
organizer.py