    "    print(f\"🚀 ЗАПУСК АНСАМБЛИРОВАНИЯ: {fold}\")\n",
    "    print(\"=\"*80)\n",
    "    !python -m _tools.ensemble_predictor --dataset_dir {DATASET_DIR} --fold {fold} --max_k {MAX_K}"
